{
  "name": "blind-push-gateway-cli",
  "version": "0.0.0",
  "description": "CLI for blind-push-gateway",
  "main": "index.js",
  "bin": {
    "blind-push-gateway": "bin.js",
    "blind-push-gateway-bare": "bin-bare.js"
  },
  "files": [
    "bin.js",
    "bin-bare.js",
    "lib/"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-node -c test.js",
    "test-bare": "brittle-bare -c test.js"
  },
  "dependencies": {
    "bare-fs": "^4.7.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "blind-push-gateway": "^0.3.0",
    "corestore": "^7.9.1",
    "firebase-admin": "^14.0.0",
    "graceful-goodbye": "^1.3.3",
    "hyper-instrument": "^3.0.2",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdht": "^6.32.0",
    "paparam": "^1.10.1",
    "pino": "^10.3.1",
    "protomux-rpc-router": "^1.0.0",
    "ready-resource": "^1.2.0"
  },
  "devDependencies": {
    "bare-process": "^4.5.1",
    "bare-prom-client": "^15.1.9",
    "bare-subprocess": "^6.1.0",
    "brittle": "^4.0.1",
    "lunte": "^1.6.0",
    "newline-decoder": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "protomux-rpc": "^1.9.0",
    "which-runtime": "^1.4.0"
  },
  "imports": {
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/blind-push-gateway-cli.git"
  },
  "bugs": {
    "url": "https://github.com/holepunchto/blind-push-gateway-cli/issues"
  },
  "homepage": "https://github.com/holepunchto/blind-push-gateway-cli#readme"
}
